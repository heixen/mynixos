# Static (hand-written) dotfiles.
#
# Generated/runtime files are intentionally NOT managed here because they must
# stay writable at runtime:
#   - hypr/noctalia.lua, hypr/hyprland.conf (autogenerated stub)
#   - kitty/themes/noctalia.conf
#   - fuzzel/*.ini color variants
#   - cava/themes/*
#   - btop/themes/*
#   - nvim/lazy-lock.json (lazy.nvim writes it)
#   - nvim/lua/matugen.lua (generated colors)
{ ... }:
{
  xdg.configFile = {
    # Hyprland
    "hypr/hyprland.lua".source = ./dotfiles/hypr/hyprland.lua;
    "hypr/hyprlock.conf".source = ./dotfiles/hypr/hyprlock.conf;

    # Kitty
    "kitty/kitty.conf".source = ./dotfiles/kitty/kitty.conf;
    "kitty/macchiato.conf".source = ./dotfiles/kitty/macchiato.conf;

    # Waybar
    "waybar/config.jsonc".source = ./dotfiles/waybar/config.jsonc;
    "waybar/style.css".source = ./dotfiles/waybar/style.css;
    "waybar/scripts".source = ./dotfiles/waybar/scripts;

    # Fuzzel (colors are generated separately)
    "fuzzel/fuzzel.ini".source = ./dotfiles/fuzzel/fuzzel.ini;

    # Neovim: lazy-lock.json and lua/matugen.lua intentionally omitted.
    "nvim/init.lua".source = ./dotfiles/nvim/init.lua;
    "nvim/after".source = ./dotfiles/nvim/after;
    "nvim/lua/config".source = ./dotfiles/nvim/lua/config;
    "nvim/lua/plugins".source = ./dotfiles/nvim/lua/plugins;

    # Cava (themes/ is generated by Noctalia)
    "cava/config".source = ./dotfiles/cava/config;
    "cava/shaders".source = ./dotfiles/cava/shaders;
    "cava/waybar".source = ./dotfiles/cava/waybar;

    # btop (themes/noctalia.theme is generated)
    "btop/btop.conf".source = ./dotfiles/btop/btop.conf;
  };

  # Git: manage ~/.gitconfig directly so it can't conflict with
  # ~/.config/git/config.
  home.file.".gitconfig".source = ./dotfiles/gitconfig;
}
